<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Bold Pop tokens. Light matches the website; dark is "Chalk outlines":
         charcoal page, cream ink. Tile/accent colors are the same in both. -->
    <Color x:Key="BgLight">#fffbea</Color>
    <Color x:Key="BgDark">#16161a</Color>
    <Color x:Key="SurfaceLight">#ffffff</Color>
    <Color x:Key="SurfaceDark">#24242b</Color>
    <Color x:Key="InkLight">#111111</Color>
    <Color x:Key="InkDark">#fffbea</Color>
    <Color x:Key="SubtleLight">#4a4a4a</Color>
    <Color x:Key="SubtleDark">#b9b6ad</Color>
    <Color x:Key="HoverLight">#fff3b0</Color>
    <Color x:Key="HoverDark">#33323a</Color>

    <Color x:Key="Accent">#ff5c8a</Color>
    <Color x:Key="Highlight">#ffe14d</Color>
    <Color x:Key="Danger">#ff4d4d</Color>
    <Color x:Key="Success">#b7f171</Color>
    <!-- Text on tiles, banners, yellow and red blocks: always dark -->
    <Color x:Key="OnColor">#111111</Color>

    <Color x:Key="Tile1">#7cd4ff</Color>
    <Color x:Key="Tile2">#b7f171</Color>
    <Color x:Key="Tile3">#ffb35c</Color>
    <Color x:Key="Tile4">#c9a7ff</Color>
    <Color x:Key="Tile5">#ff5c8a</Color>

    <!-- Legacy names kept so any remaining references stay on-theme -->
    <Color x:Key="Primary">#ff5c8a</Color>
    <Color x:Key="PrimaryDark">#ff5c8a</Color>
    <Color x:Key="PrimaryDarkText">#111111</Color>
    <Color x:Key="Secondary">#c9a7ff</Color>
    <Color x:Key="SecondaryDarkText">#c9a7ff</Color>
    <Color x:Key="Tertiary">#111111</Color>
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#ff5c8a</Color>
    <Color x:Key="MidnightBlue">#16161a</Color>
    <Color x:Key="OffBlack">#16161a</Color>
    <Color x:Key="Gray100">#eeeae0</Color>
    <Color x:Key="Gray200">#d9d5ca</Color>
    <Color x:Key="Gray300">#b9b6ad</Color>
    <Color x:Key="Gray400">#8f8c85</Color>
    <Color x:Key="Gray500">#6b6862</Color>
    <Color x:Key="Gray600">#4a4a4a</Color>
    <Color x:Key="Gray900">#24242b</Color>
    <Color x:Key="Gray950">#16161a</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Tile4}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource InkLight}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
