<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WishList.ViewModels"
             xmlns:models="clr-namespace:WishList.Models"
             x:Class="WishList.Views.BrowserPage"
             x:DataType="vm:BrowserViewModel"
             Title="Browse for Item">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Top bar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="8" BackgroundColor="{StaticResource Primary}">
            <Button Grid.Column="0" Text="Back"
                    Command="{Binding BackToQuickLaunchCommand}"
                    IsVisible="{Binding ShowBrowser}"
                    BackgroundColor="Transparent" TextColor="White" />
            <Label Grid.Column="1" Text="{Binding CurrentUrl}" TextColor="White"
                   VerticalOptions="Center" LineBreakMode="TailTruncation"
                   Margin="8,0" FontSize="12" />
            <Button Grid.Column="2"
                    Text="{Binding IsScraping, Converter={StaticResource BusyTextConverter}, ConverterParameter='Capturing...|Capture This Item'}"
                    Command="{Binding CaptureItemCommand}"
                    IsEnabled="{Binding IsScraping, Converter={StaticResource InvertedBoolConverter}}"
                    IsVisible="{Binding ShowBrowser}"
                    BackgroundColor="#28a745" TextColor="White"
                    FontAttributes="Bold" Padding="12,0" />
        </Grid>

        <!-- Quick launch grid -->
        <ScrollView Grid.Row="1" IsVisible="{Binding ShowQuickLaunch}">
            <VerticalStackLayout Padding="16" Spacing="8">
                <Label Text="Choose a shopping site" FontSize="20" FontAttributes="Bold"
                       HorizontalOptions="Center" Margin="0,16" />
                <Label Text="{Binding ErrorMessage}" TextColor="Red"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                       HorizontalOptions="Center" />
                <FlexLayout Wrap="Wrap" JustifyContent="Center" AlignItems="Start"
                            BindableLayout.ItemsSource="{Binding AllowedDomains}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:AllowedDomain">
                            <Frame Style="{StaticResource CardFrame}" Margin="6"
                                   WidthRequest="140" HeightRequest="80">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BrowserViewModel}}, Path=OpenSiteCommand}"
                                        CommandParameter="{Binding}" />
                                </Frame.GestureRecognizers>
                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                    <Label Text="{Binding DisplayName}" FontAttributes="Bold"
                                           HorizontalOptions="Center" FontSize="14" />
                                    <Label Text="{Binding Domain}" TextColor="Gray"
                                           HorizontalOptions="Center" FontSize="11" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- WebView browser -->
        <WebView Grid.Row="1" x:Name="BrowserWebView"
                 Source="{Binding CurrentUrl}"
                 IsVisible="{Binding ShowBrowser}"
                 Navigating="OnWebViewNavigating"
                 Navigated="OnWebViewNavigated" />

        <!-- Error bar -->
        <Label Grid.Row="2" Text="{Binding ErrorMessage}" TextColor="Red"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}"
               Padding="8" BackgroundColor="#fff3cd" />
    </Grid>
</ContentPage>
