<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:WishList.Controls"
             xmlns:vm="clr-namespace:WishList.ViewModels"
             xmlns:models="clr-namespace:WishList.Models"
             x:Class="WishList.Views.FamiliesPage"
             x:DataType="vm:FamiliesViewModel"
             Title="Families">

    <Grid RowDefinitions="Auto,*">

        <HorizontalStackLayout Grid.Row="0" Padding="16,16,16,4" Spacing="10">
            <Button Text="+ Create Family"
                    Command="{Binding CreateFamilyCommand}"
                    Style="{StaticResource PrimaryButton}"
                    HeightRequest="36" Padding="12,0" />
            <Button Text="Join Family"
                    Command="{Binding JoinFamilyCommand}"
                    Style="{StaticResource OutlineButton}"
                    HeightRequest="36" Padding="12,0" />
        </HorizontalStackLayout>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadFamiliesCommand}">
            <CollectionView ItemsSource="{Binding Families}"
                            EmptyView="No families yet. Create or join one!">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Family">
                        <controls:PopCard Margin="16,8" InnerPadding="0">
                            <VerticalStackLayout Spacing="0">
                            <BoxView HeightRequest="12" Color="{Binding ColorHex, Converter={StaticResource HexToColor}}" />
                            <BoxView HeightRequest="2.5" />
                            <Grid ColumnDefinitions="*,Auto" Padding="16,12,16,14">
                                <VerticalStackLayout Grid.Column="0">
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FamiliesViewModel}}, Path=OpenFamilyCommand}"
                                            CommandParameter="{Binding}" />
                                    </VerticalStackLayout.GestureRecognizers>
                                    <Label Text="{Binding Name}" FontSize="18" FontFamily="DisplayBold" />
                                    <Label Text="{Binding MemberCount, StringFormat='{0} members'}"
                                           TextColor="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" FontSize="13" />
                                    <Border Style="{StaticResource Pill}" BackgroundColor="{Binding RoleColorHex, Converter={StaticResource HexToColor}}" Margin="0,6,0,0">
                                        <Label Text="{Binding EffectiveRole}" FontFamily="DisplayBold" FontSize="10" TextColor="{StaticResource OnColor}" />
                                    </Border>
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="View Lists"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FamiliesViewModel}}, Path=ViewFamilyListsCommand}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource SmallButton}"
                                        VerticalOptions="Center" />
                            </Grid>
                            </VerticalStackLayout>
                        </controls:PopCard>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Border Style="{StaticResource ErrorBlock}" IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}" Margin="16,0">
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
        </Border>
    </Grid>
</ContentPage>
