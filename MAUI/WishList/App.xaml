<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:WishList"
             xmlns:converters="clr-namespace:WishList.Converters"
             x:Class="WishList.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter" />
            <converters:BusyTextConverter x:Key="BusyTextConverter" />
            <converters:PriceConverter x:Key="PriceConverter" />
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
            <converters:CompactSizeConverter x:Key="CompactSize" />

            <converters:HexToColorConverter x:Key="HexToColor" />

            <!-- Bold Pop buttons: 2.5 ink outline, display font -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource BgDark}}" />
                <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                <Setter Property="BorderWidth" Value="2.5" />
                <Setter Property="FontFamily" Value="DisplayBold" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="HeightRequest" Value="46" />
            </Style>

            <Style x:Key="OutlineButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                <Setter Property="BorderWidth" Value="2.5" />
                <Setter Property="FontFamily" Value="DisplayBold" />
                <Setter Property="CornerRadius" Value="9" />
            </Style>

            <Style x:Key="DangerButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Danger}" />
                <Setter Property="TextColor" Value="{StaticResource OnColor}" />
                <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                <Setter Property="BorderWidth" Value="2.5" />
                <Setter Property="FontFamily" Value="DisplayBold" />
                <Setter Property="CornerRadius" Value="9" />
            </Style>

            <!-- Small button variant for tiles and toolbars -->
            <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                <Setter Property="BorderWidth" Value="2" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="9,0" />
                <Setter Property="HeightRequest" Value="30" />
                <Setter Property="MinimumHeightRequest" Value="30" />
            </Style>

            <!-- Legacy card style: flat outlined look (PopCard is preferred) -->
            <Style x:Key="CardFrame" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="HasShadow" Value="False" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
