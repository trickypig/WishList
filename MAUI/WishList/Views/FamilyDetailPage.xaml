<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:WishList.Controls"
             xmlns:vm="clr-namespace:WishList.ViewModels"
             xmlns:models="clr-namespace:WishList.Models"
             x:Class="WishList.Views.FamilyDetailPage"
             x:DataType="vm:FamilyDetailViewModel"
             Title="{Binding Family.Name}">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">

            <Border Style="{StaticResource ErrorBlock}" IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>

            <!-- Invite Code -->
            <controls:PopCard>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Invite Code" FontFamily="DisplayBold" FontSize="16" />
                    <HorizontalStackLayout Spacing="10">
                        <Border BackgroundColor="{StaticResource Highlight}" Stroke="{StaticResource OnColor}"
                                StrokeThickness="2.5" StrokeShape="RoundRectangle 9" Padding="12,6">
                            <Label Text="{Binding Family.InviteCode}" FontSize="20" FontFamily="DisplayBold"
                                   CharacterSpacing="2" TextColor="{StaticResource OnColor}" />
                        </Border>
                        <Button Text="{Binding Copied, Converter={StaticResource BusyTextConverter}, ConverterParameter='Copied!|Copy'}"
                                Command="{Binding CopyInviteCodeCommand}"
                                Style="{StaticResource SmallButton}" />
                    </HorizontalStackLayout>
                    <Label Text="Share this code with others so they can join your family group."
                           TextColor="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" FontSize="12" />
                </VerticalStackLayout>
            </controls:PopCard>

            <!-- Members -->
            <controls:PopCard>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Members" FontFamily="DisplayBold" FontSize="16" />
                    <CollectionView ItemsSource="{Binding Members}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:FamilyMember">
                                <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                                    <VerticalStackLayout Grid.Column="0">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding DisplayName}" FontFamily="DisplayBold" />
                                            <Border Style="{StaticResource Pill}" BackgroundColor="{StaticResource Tile4}"
                                                    IsVisible="{Binding IsChild}">
                                                <Label Text="CHILD" FontFamily="DisplayBold" FontSize="10" TextColor="{StaticResource OnColor}" />
                                            </Border>
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding Email}" TextColor="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" FontSize="12" />
                                        <Border Style="{StaticResource Pill}" BackgroundColor="{Binding RoleColorHex, Converter={StaticResource HexToColor}}" Margin="0,4,0,0">
                                            <Label Text="{Binding Role}" FontFamily="DisplayBold" FontSize="10" TextColor="{StaticResource OnColor}" />
                                        </Border>
                                    </VerticalStackLayout>
                                    <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                        <Button Text="Toggle Child"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FamilyDetailViewModel}}, Path=ToggleChildCommand}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SmallButton}"
                                                IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:FamilyDetailViewModel}}, Path=IsParent}" />
                                        <Button Text="Remove"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FamilyDetailViewModel}}, Path=RemoveMemberCommand}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SmallButton}" BackgroundColor="{StaticResource Danger}" TextColor="{StaticResource OnColor}"
                                                IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:FamilyDetailViewModel}}, Path=IsAdmin}" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </controls:PopCard>

            <!-- Invite by Email (admin only) -->
            <controls:PopCard IsVisible="{Binding IsAdmin}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Invite by Email" FontFamily="DisplayBold" FontSize="16" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Border Style="{StaticResource Field}" Grid.Column="0">
                            <Entry Placeholder="email@example.com" Text="{Binding InviteEmail}"
                               Keyboard="Email" />
                        </Border>
                        <Button Grid.Column="1" Text="Send" Command="{Binding InviteCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HeightRequest="42" Padding="16,0" />
                    </Grid>
                </VerticalStackLayout>
            </controls:PopCard>

            <!-- Domain management (parent only) -->
            <controls:PopCard IsVisible="{Binding IsParent}">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="Allowed Shopping Domains" FontFamily="DisplayBold" FontSize="16" />
                        <Button Text="+ Add" Command="{Binding AddDomainCommand}"
                                Style="{StaticResource SmallButton}" />
                    </HorizontalStackLayout>
                    <CollectionView ItemsSource="{Binding Domains}"
                                    EmptyView="No domains configured.">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:AllowedDomain">
                                <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,4">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding DisplayName}" FontFamily="DisplayBold" FontSize="14" />
                                        <Label Text="{Binding Domain}" TextColor="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding Source}" TextColor="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}"
                                           FontSize="10" VerticalOptions="Center" Margin="4,0" />
                                    <Button Grid.Column="2" Text="Remove"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FamilyDetailViewModel}}, Path=RemoveDomainCommand}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SmallButton}" BackgroundColor="{StaticResource Danger}" TextColor="{StaticResource OnColor}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </controls:PopCard>

            <!-- Leave button (non-admin) -->
            <Button Text="Leave Family"
                    Command="{Binding LeaveCommand}"
                    Style="{StaticResource DangerButton}"
                    IsVisible="{Binding IsAdmin, Converter={StaticResource InvertedBoolConverter}}"
                    Margin="0,8" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
