<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WishList.ViewModels"
             x:Class="WishList.Views.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             Title="Reset Password"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center" MaximumWidthRequest="400">

            <Label Text="Reset Password"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource Primary}" />

            <Label Text="{Binding SuccessMessage}"
                   TextColor="Green"
                   IsVisible="{Binding SuccessMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                   HorizontalTextAlignment="Center" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                   HorizontalTextAlignment="Center" />

            <!-- Step 1: ask for the email -->
            <VerticalStackLayout Spacing="20" IsVisible="{Binding IsEmailStep}">
                <Label Text="We'll email you a code to reset it"
                       FontSize="16"
                       HorizontalOptions="Center"
                       TextColor="Gray" />

                <Entry Placeholder="Email"
                       Text="{Binding Email}"
                       Keyboard="Email"
                       ReturnType="Done"
                       ReturnCommand="{Binding SendCodeCommand}" />

                <Button Text="{Binding IsBusy, Converter={StaticResource BusyTextConverter}, ConverterParameter='Sending...|Send Reset Code'}"
                        Command="{Binding SendCodeCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        Style="{StaticResource PrimaryButton}" />
            </VerticalStackLayout>

            <!-- Step 2: enter the emailed code and a new password -->
            <VerticalStackLayout Spacing="20" IsVisible="{Binding IsCodeStep}">
                <Label Text="Enter the code from your email and choose a new password"
                       FontSize="16"
                       HorizontalTextAlignment="Center"
                       TextColor="Gray" />

                <Entry Placeholder="6-digit code"
                       Text="{Binding Code}"
                       Keyboard="Numeric"
                       ReturnType="Next" />

                <Entry Placeholder="New password (at least 6 characters)"
                       Text="{Binding NewPassword}"
                       IsPassword="True"
                       ReturnType="Next" />

                <Entry Placeholder="Confirm new password"
                       Text="{Binding ConfirmPassword}"
                       IsPassword="True"
                       ReturnType="Done"
                       ReturnCommand="{Binding ResetPasswordCommand}" />

                <Button Text="{Binding IsBusy, Converter={StaticResource BusyTextConverter}, ConverterParameter='Resetting...|Reset Password'}"
                        Command="{Binding ResetPasswordCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        Style="{StaticResource PrimaryButton}" />

                <Button Text="Send another code"
                        Command="{Binding RequestAnotherCodeCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Primary}" />
            </VerticalStackLayout>

            <Button Text="Back to sign in"
                    Command="{Binding GoToLoginCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
