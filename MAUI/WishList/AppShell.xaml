<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:WishList.Views"
       x:Class="WishList.AppShell"
       Shell.FlyoutBehavior="Disabled">

    <!-- Auth pages (no tabs) -->
    <ShellContent Route="login" ContentTemplate="{DataTemplate views:LoginPage}" Shell.TabBarIsVisible="False" />
    <ShellContent Route="register" ContentTemplate="{DataTemplate views:RegisterPage}" Shell.TabBarIsVisible="False" />

    <!-- Main tabbed interface -->
    <TabBar Route="main">
        <ShellContent Route="dashboard" Title="Lists"
                      ContentTemplate="{DataTemplate views:DashboardPage}" />
        <ShellContent Route="families" Title="Families"
                      ContentTemplate="{DataTemplate views:FamiliesPage}" />
        <ShellContent Route="settings" Title="Settings"
                      ContentTemplate="{DataTemplate views:SettingsPage}" />
    </TabBar>

</Shell>
