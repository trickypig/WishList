<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:WishList.Controls"
             xmlns:vm="clr-namespace:WishList.ViewModels"
             xmlns:models="clr-namespace:WishList.Models"
             x:Class="WishList.Views.BrowserPage"
             x:DataType="vm:BrowserViewModel"
             Title="Browse for Item">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Top bar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="8" BackgroundColor="{StaticResource Accent}">
            <Button Grid.Column="0" Text="Back"
                    Command="{Binding BackToQuickLaunchCommand}"
                    IsVisible="{Binding ShowBrowser}"
                    Style="{StaticResource SmallButton}" />
            <Label Grid.Column="1" Text="{Binding CurrentUrl}" TextColor="{StaticResource OnColor}"
                   VerticalOptions="Center" LineBreakMode="TailTruncation"
                   Margin="8,0" FontSize="12" />
            <Button Grid.Column="2"
                    Text="{Binding IsScraping, Converter={StaticResource BusyTextConverter}, ConverterParameter='Capturing...|Capture This Item'}"
                    Command="{Binding CaptureItemCommand}"
                    IsEnabled="{Binding IsScraping, Converter={StaticResource InvertedBoolConverter}}"
                    IsVisible="{Binding ShowBrowser}"
                    Style="{StaticResource PrimaryButton}" HeightRequest="38" Padding="14,0" />
        </Grid>

        <!-- Quick launch grid -->
        <ScrollView Grid.Row="1" IsVisible="{Binding ShowQuickLaunch}">
            <VerticalStackLayout Padding="16" Spacing="8">
                <Label Text="Choose a shopping site" FontSize="20" FontFamily="DisplayBold"
                       HorizontalOptions="Center" Margin="0,16" />
                <Border Style="{StaticResource ErrorBlock}" IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
                </Border>
                <FlexLayout Wrap="Wrap" JustifyContent="Center" AlignItems="Start"
                            BindableLayout.ItemsSource="{Binding AllowedDomains}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:AllowedDomain">
                            <controls:PopCard Margin="6"
                                   WidthRequest="140" HeightRequest="80">
                                <controls:PopCard.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BrowserViewModel}}, Path=OpenSiteCommand}"
                                        CommandParameter="{Binding}" />
                                </controls:PopCard.GestureRecognizers>
                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                    <Label Text="{Binding DisplayName}" FontFamily="DisplayBold"
                                           HorizontalOptions="Center" FontSize="14" />
                                    <Label Text="{Binding Domain}" TextColor="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}"
                                           HorizontalOptions="Center" FontSize="11" />
                                </VerticalStackLayout>
                            </controls:PopCard>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- WebView browser -->
        <WebView Grid.Row="1" x:Name="BrowserWebView"
                 Source="{Binding CurrentUrl}"
                 IsVisible="{Binding ShowBrowser}"
                 Navigating="OnWebViewNavigating"
                 Navigated="OnWebViewNavigated" />

        <!-- Error bar -->
        <Label Grid.Row="2" Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}"
               Padding="8" />
    </Grid>
</ContentPage>
