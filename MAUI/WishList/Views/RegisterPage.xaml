<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WishList.ViewModels"
             xmlns:controls="clr-namespace:WishList.Controls"
             x:Class="WishList.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="Register"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid Padding="20,40" VerticalOptions="Center">
            <controls:PopCard Offset="5" CornerRadius="16" InnerPadding="0"
                              MaximumWidthRequest="440" HorizontalOptions="Center" WidthRequest="440">
                <VerticalStackLayout Spacing="0">
                    <!-- Pink header band -->
                    <Grid BackgroundColor="{StaticResource Accent}" Padding="20,22,20,18">
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                            <Label Text="✨ WISHLIST" FontFamily="DisplayBold" FontSize="12" CharacterSpacing="1.5"
                                   TextColor="{StaticResource OnColor}" HorizontalOptions="Center" />
                            <Label Text="Create Account" Style="{StaticResource H1}" TextColor="{StaticResource OnColor}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="2.5" />

                    <VerticalStackLayout Spacing="14" Padding="24,18,24,24">
                        <Label Text="Create your account" Style="{StaticResource Subtle}" FontSize="14" HorizontalTextAlignment="Center" />
                        <Border Style="{StaticResource ErrorBlock}"
                                IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
                        </Border>
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Display Name" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource Field}">
                                <Entry Placeholder="Your name" Text="{Binding DisplayName}" ReturnType="Next" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Email" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource Field}">
                                <Entry Placeholder="you@example.com" Text="{Binding Email}" Keyboard="Email" ReturnType="Next" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Password" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource Field}">
                                <Entry Placeholder="6+ characters" Text="{Binding Password}" IsPassword="True" ReturnType="Done" ReturnCommand="{Binding RegisterCommand}" />
                            </Border>
                        </VerticalStackLayout>
                        <Button Text="{Binding IsBusy, Converter={StaticResource BusyTextConverter}, ConverterParameter='Creating account...|Create Account'}"
                                Command="{Binding RegisterCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                                Style="{StaticResource PrimaryButton}" Margin="0,4,0,0" />
                        <Button Text="Already have an account? Sign in" Command="{Binding GoToLoginCommand}"
                                Style="{StaticResource LinkButton}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </controls:PopCard>
        </Grid>
    </ScrollView>
</ContentPage>
