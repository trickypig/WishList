<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:WishList.Controls"
             xmlns:vm="clr-namespace:WishList.ViewModels"
             xmlns:models="clr-namespace:WishList.Models"
             x:Class="WishList.Views.ItemFormPage"
             x:DataType="vm:ItemFormViewModel"
             Title="{Binding PageTitle}">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="10" MaximumWidthRequest="600">

            <Border Style="{StaticResource ErrorBlock}" IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>

            <!-- URL Scraping -->
            <controls:PopCard>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Paste URL to auto-fill" FontFamily="DisplayBold" />
                    <Border Style="{StaticResource Field}">
                        <Entry Placeholder="https://www.amazon.com/..."
                           Text="{Binding ScrapeUrl}" />
                    </Border>
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="{Binding IsScraping, Converter={StaticResource BusyTextConverter}, ConverterParameter='Scraping...|Scrape URL'}"
                                Command="{Binding ScrapeCommand}"
                                IsEnabled="{Binding IsScraping, Converter={StaticResource InvertedBoolConverter}}"
                                Style="{StaticResource PrimaryButton}"
                                HeightRequest="36" Padding="12,0" />
                        <!-- Windows-only: Browse for Item button -->
                        <Button Text="Browse for Item"
                                Clicked="OnBrowseForItemClicked"
                                Style="{StaticResource OutlineButton}"
                                HeightRequest="36" Padding="12,0"
                                IsVisible="{OnPlatform WinUI=True, Default=False}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </controls:PopCard>

            <!-- Move to another of the owner's lists -->
            <VerticalStackLayout Spacing="6" IsVisible="{Binding CanMove}">
                <Label Text="List" FontFamily="DisplayBold" />
                <Border Style="{StaticResource Field}">
                    <Picker ItemsSource="{Binding MoveLists}"
                            ItemDisplayBinding="{Binding Title, x:DataType=models:WishListModel}"
                            SelectedItem="{Binding SelectedList}" />
                </Border>
                <Label Text="Saving moves this item to the end of that list."
                       FontSize="12" Opacity="0.7" IsVisible="{Binding IsMoving}" />
            </VerticalStackLayout>

            <!-- Item fields -->
            <Label Text="Name" FontFamily="DisplayBold" />
            <Border Style="{StaticResource Field}">
                <Entry Placeholder="Item name" Text="{Binding Name}" />
            </Border>

            <Label Text="Description" FontFamily="DisplayBold" />
            <Border Style="{StaticResource Field}">
                <Editor Placeholder="Description (optional)" Text="{Binding Description}"
                    HeightRequest="80" />
            </Border>

            <Label Text="Price" FontFamily="DisplayBold" />
            <Border Style="{StaticResource Field}">
                <Entry Placeholder="0.00" Text="{Binding PriceText}" Keyboard="Numeric" />
            </Border>

            <Label Text="Quantity" FontFamily="DisplayBold" />
            <Border Style="{StaticResource Field}">
                <Entry Placeholder="1" Text="{Binding QuantityDesired}" Keyboard="Numeric" />
            </Border>

            <Label Text="Image URL" FontFamily="DisplayBold" />
            <Border Style="{StaticResource Field}">
                <Entry Placeholder="https://..." Text="{Binding ImageUrl}" />
            </Border>

            <!-- Image preview -->
            <Image Source="{Binding ImageUrl}" HeightRequest="120" Aspect="AspectFit"
                   IsVisible="{Binding ImageUrl, Converter={StaticResource IsNotNullOrEmptyConverter}}" />

            <!-- Links -->
            <Label Text="Store Links" FontFamily="DisplayBold" FontSize="16" />
            <CollectionView ItemsSource="{Binding Links}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ItemLink">
                        <Grid ColumnDefinitions="*,110,Auto" ColumnSpacing="8" Padding="0,4">
                            <Border Style="{StaticResource Field}" Grid.Column="0">
                                <Entry Placeholder="URL" Text="{Binding Url}" />
                            </Border>
                            <Border Style="{StaticResource Field}" Grid.Column="1">
                                <Entry Placeholder="Store" Text="{Binding StoreName}" />
                            </Border>
                            <Button Grid.Column="2" Text="✕"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemFormViewModel}}, Path=RemoveLinkCommand}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource DangerButton}"
                                    HeightRequest="40" WidthRequest="40" Padding="0" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="+ Add Link" Command="{Binding AddLinkCommand}"
                    Style="{StaticResource OutlineButton}" HeightRequest="36" />

            <!-- Save button -->
            <Button Text="{Binding IsBusy, Converter={StaticResource BusyTextConverter}, ConverterParameter='Saving...|Save Item'}"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,16,0,32" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
