<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WishList.ViewModels"
             xmlns:controls="clr-namespace:WishList.Controls"
             x:Class="WishList.Views.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             Title="Forgot Password"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid Padding="20,40" VerticalOptions="Center">
            <controls:PopCard Offset="5" CornerRadius="16" InnerPadding="0"
                              MaximumWidthRequest="440" HorizontalOptions="Center" WidthRequest="440">
                <VerticalStackLayout Spacing="0">
                    <!-- Pink header band -->
                    <Grid BackgroundColor="{StaticResource Accent}" Padding="20,22,20,18">
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                            <Label Text="✨ WISHLIST" FontFamily="DisplayBold" FontSize="12" CharacterSpacing="1.5"
                                   TextColor="{StaticResource OnColor}" HorizontalOptions="Center" />
                            <Label Text="Reset Password" Style="{StaticResource H1}" TextColor="{StaticResource OnColor}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="2.5" />

                    <VerticalStackLayout Spacing="14" Padding="24,18,24,24">
                        <Border Style="{StaticResource ErrorBlock}" BackgroundColor="{StaticResource Success}"
                                IsVisible="{Binding SuccessMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                            <Label Text="{Binding SuccessMessage}" Style="{StaticResource ErrorText}" />
                        </Border>
                        <Border Style="{StaticResource ErrorBlock}"
                                IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
                        </Border>
                        <!-- Step 1: ask for the email -->
                        <VerticalStackLayout Spacing="14" IsVisible="{Binding IsEmailStep}">
                        <Label Text="We'll email you a code to reset it" Style="{StaticResource Subtle}" FontSize="14" HorizontalTextAlignment="Center" />
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Email" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource Field}">
                                <Entry Placeholder="you@example.com" Text="{Binding Email}" Keyboard="Email" ReturnType="Done" ReturnCommand="{Binding SendCodeCommand}" />
                            </Border>
                        </VerticalStackLayout>
                        <Button Text="{Binding IsBusy, Converter={StaticResource BusyTextConverter}, ConverterParameter='Sending...|Send Reset Code'}"
                                Command="{Binding SendCodeCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                                Style="{StaticResource PrimaryButton}" />
                        </VerticalStackLayout>
                        <!-- Step 2: enter the emailed code and a new password -->
                        <VerticalStackLayout Spacing="14" IsVisible="{Binding IsCodeStep}">
                        <Label Text="Enter the code from your email and choose a new password" Style="{StaticResource Subtle}" FontSize="14" HorizontalTextAlignment="Center" />
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Code" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource Field}">
                                <Entry Placeholder="6-digit code" Text="{Binding Code}" Keyboard="Numeric" ReturnType="Next" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="0">
                            <Label Text="New Password" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource Field}">
                                <Entry Placeholder="At least 6 characters" Text="{Binding NewPassword}" IsPassword="True" ReturnType="Next" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Confirm New Password" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource Field}">
                                <Entry Placeholder="Type it again" Text="{Binding ConfirmPassword}" IsPassword="True" ReturnType="Done" ReturnCommand="{Binding ResetPasswordCommand}" />
                            </Border>
                        </VerticalStackLayout>
                        <Button Text="{Binding IsBusy, Converter={StaticResource BusyTextConverter}, ConverterParameter='Resetting...|Reset Password'}"
                                Command="{Binding ResetPasswordCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                                Style="{StaticResource PrimaryButton}" />
                        <Button Text="Send another code" Command="{Binding RequestAnotherCodeCommand}"
                                Style="{StaticResource LinkButton}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <Button Text="Back to sign in" Command="{Binding GoToLoginCommand}"
                                Style="{StaticResource LinkButton}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </controls:PopCard>
        </Grid>
    </ScrollView>
</ContentPage>
